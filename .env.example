# =============================================================================
# Environment template — Aliyun single-machine is the primary production path
# Copy to repo-root `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Required (Aliyun + local) ---
DB_VENDOR=supabase_http
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE=your-service-role-key
SUPABASE_USE_HTTP=1

# Optional direct Postgres URL (usually unused when DB_VENDOR=supabase_http)
# SUPABASE_DB_URL=postgresql://user:password@host:5432/dbname

# Optional MySQL (only when DB_VENDOR is not supabase_http, or for local ETL scripts
# under modules/data_import + data_processing that still use modules.database.db_config)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=123456
# MYSQL_DATABASE=settlement_monitoring

# Gunicorn / local bind (Aliyun systemd uses 127.0.0.1:5000 behind Nginx)
PORT=5000

# --- Optional: tickets / SMTP ---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-email@qq.com
SMTP_FROM_NAME=工单系统
SMTP_USE_SSL=true
SMTP_USE_TLS=false
# USER_EMAIL_admin=admin@example.com
TICKET_SCHEDULER_ENABLED=0

# --- Optional: AI assistant ---
# DEEPSEEK_API_KEY=

# --- Optional: cover cameras ---
COVER_CAMERA_ENTRANCE_URL=/static/videos/entrance.mp4
COVER_CAMERA_MIDDLE_URL=/static/videos/middle.mp4
COVER_CAMERAS_JSON=

# =============================================================================
# Vercel-only (secondary / legacy hosting — not needed on Aliyun)
# =============================================================================
# VERCEL=1
